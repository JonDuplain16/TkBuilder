{
  "version": 2,
  "settings": {
    "app_name": "Click Counter",
    "theme": "sunset",
    "font_family": "",
    "font_size": 0,
    "dpi_aware": true,
    "code_style": "split",
    "backend_dir": "",
    "threads": true,
    "description": "Three buttons that change a number - no code at all."
  },
  "windows": [
    {
      "id": "main_window",
      "type": "Window",
      "props": {
        "title": "Click Counter",
        "icon": "",
        "width": 300,
        "height": 210,
        "min_width": 0,
        "min_height": 0,
        "padding": 12,
        "resizable": true,
        "start": "center",
        "topmost": false,
        "timer_ms": 0,
        "bg": "",
        "menu": []
      },
      "layout": {
        "row": 0,
        "col": 0,
        "rowspan": 1,
        "colspan": 1,
        "fill": "none",
        "halign": "left",
        "valign": "center",
        "padx": 6,
        "pady": 4
      },
      "events": {
        "on_open": [],
        "on_close": [],
        "on_timer": []
      },
      "hooks": [],
      "children": [
        {
          "id": "count",
          "type": "Label",
          "props": {
            "text": "0",
            "variant": "Title",
            "image": "",
            "compound": "left",
            "anchor": "center",
            "justify": "left",
            "wraplength": 0,
            "width": 0,
            "font": {
              "family": "",
              "size": 36,
              "bold": true,
              "italic": false,
              "underline": false
            },
            "fg": "",
            "bg": "",
            "tooltip": "",
            "cursor": ""
          },
          "layout": {
            "row": 0,
            "col": 0,
            "rowspan": 1,
            "colspan": 3,
            "fill": "x",
            "halign": "left",
            "valign": "center",
            "padx": 6,
            "pady": 4
          },
          "events": {
            "on_click": []
          },
          "hooks": []
        },
        {
          "id": "button1",
          "type": "Button",
          "props": {
            "text": "\u2212 1",
            "variant": "",
            "image": "",
            "compound": "left",
            "shortcut": "",
            "default": false,
            "width": 6,
            "font": {
              "family": "",
              "size": 0,
              "bold": false,
              "italic": false,
              "underline": false
            },
            "fg": "",
            "bg": "",
            "state": "normal",
            "tooltip": "",
            "cursor": ""
          },
          "layout": {
            "row": 1,
            "col": 0,
            "rowspan": 1,
            "colspan": 1,
            "fill": "none",
            "halign": "left",
            "valign": "center",
            "padx": 6,
            "pady": 4
          },
          "events": {
            "command": [
              {
                "type": "change_number",
                "params": {
                  "target": "count",
                  "amount": -1
                }
              }
            ]
          },
          "hooks": [
            "command"
          ]
        },
        {
          "id": "button2",
          "type": "Button",
          "props": {
            "text": "Reset",
            "variant": "",
            "image": "",
            "compound": "left",
            "shortcut": "",
            "default": false,
            "width": 6,
            "font": {
              "family": "",
              "size": 0,
              "bold": false,
              "italic": false,
              "underline": false
            },
            "fg": "",
            "bg": "",
            "state": "normal",
            "tooltip": "",
            "cursor": ""
          },
          "layout": {
            "row": 1,
            "col": 1,
            "rowspan": 1,
            "colspan": 1,
            "fill": "none",
            "halign": "left",
            "valign": "center",
            "padx": 6,
            "pady": 4
          },
          "events": {
            "command": [
              {
                "type": "set_text",
                "params": {
                  "target": "count",
                  "text": "0"
                }
              }
            ]
          },
          "hooks": [
            "command"
          ]
        },
        {
          "id": "button3",
          "type": "Button",
          "props": {
            "text": "+ 1",
            "variant": "Accent",
            "image": "",
            "compound": "left",
            "shortcut": "",
            "default": false,
            "width": 6,
            "font": {
              "family": "",
              "size": 0,
              "bold": false,
              "italic": false,
              "underline": false
            },
            "fg": "",
            "bg": "",
            "state": "normal",
            "tooltip": "",
            "cursor": ""
          },
          "layout": {
            "row": 1,
            "col": 2,
            "rowspan": 1,
            "colspan": 1,
            "fill": "none",
            "halign": "left",
            "valign": "center",
            "padx": 6,
            "pady": 4
          },
          "events": {
            "command": [
              {
                "type": "change_number",
                "params": {
                  "target": "count",
                  "amount": 1
                }
              }
            ]
          },
          "hooks": [
            "command"
          ]
        }
      ]
    }
  ]
}