{
  "version": 1,
  "app_name": "My App",
  "windows": [
    {
      "id": "main_window",
      "type": "Window",
      "props": {
        "title": "Greeter",
        "width": 360,
        "height": 180,
        "resizable": true,
        "padding": 10,
        "bg": "",
        "menu": []
      },
      "layout": {
        "row": 0,
        "col": 0,
        "rowspan": 1,
        "colspan": 1,
        "fill": "none",
        "halign": "center",
        "valign": "center",
        "padx": 5,
        "pady": 5
      },
      "events": {
        "on_open": [],
        "on_close": []
      },
      "children": [
        {
          "id": "question",
          "type": "Label",
          "props": {
            "text": "What's your name?",
            "image": "",
            "justify": "left",
            "wraplength": 0,
            "width": 0,
            "font": {
              "family": "",
              "size": 0,
              "bold": false,
              "italic": false,
              "underline": false
            },
            "fg": "",
            "bg": ""
          },
          "layout": {
            "row": 0,
            "col": 0,
            "rowspan": 1,
            "colspan": 1,
            "fill": "none",
            "halign": "center",
            "valign": "center",
            "padx": 5,
            "pady": 5
          },
          "events": {}
        },
        {
          "id": "name_box",
          "type": "Entry",
          "props": {
            "text": "",
            "password": false,
            "width": 20,
            "font": {
              "family": "",
              "size": 0,
              "bold": false,
              "italic": false,
              "underline": false
            },
            "fg": "",
            "bg": "",
            "state": "normal"
          },
          "layout": {
            "row": 0,
            "col": 1,
            "rowspan": 1,
            "colspan": 1,
            "fill": "none",
            "halign": "center",
            "valign": "center",
            "padx": 5,
            "pady": 5
          },
          "events": {
            "on_enter": [
              {
                "type": "check",
                "params": {
                  "target": "name_box",
                  "condition": "not_empty",
                  "value": "",
                  "message": "Please type your name first."
                }
              },
              {
                "type": "set_text",
                "params": {
                  "target": "greeting",
                  "text": "Hello, {name_box}! \ud83d\udc4b"
                }
              }
            ]
          }
        },
        {
          "id": "hello_button",
          "type": "Button",
          "props": {
            "text": "Say hello",
            "image": "",
            "width": 0,
            "font": {
              "family": "",
              "size": 0,
              "bold": false,
              "italic": false,
              "underline": false
            },
            "fg": "",
            "bg": "",
            "state": "normal"
          },
          "layout": {
            "row": 1,
            "col": 0,
            "rowspan": 1,
            "colspan": 2,
            "fill": "none",
            "halign": "center",
            "valign": "center",
            "padx": 5,
            "pady": 5
          },
          "events": {
            "command": [
              {
                "type": "check",
                "params": {
                  "target": "name_box",
                  "condition": "not_empty",
                  "value": "",
                  "message": "Please type your name first."
                }
              },
              {
                "type": "set_text",
                "params": {
                  "target": "greeting",
                  "text": "Hello, {name_box}! \ud83d\udc4b"
                }
              }
            ]
          }
        },
        {
          "id": "greeting",
          "type": "Label",
          "props": {
            "text": "",
            "image": "",
            "justify": "left",
            "wraplength": 0,
            "width": 0,
            "font": {
              "family": "",
              "size": 14,
              "bold": true,
              "italic": false,
              "underline": false
            },
            "fg": "#2563eb",
            "bg": ""
          },
          "layout": {
            "row": 2,
            "col": 0,
            "rowspan": 1,
            "colspan": 2,
            "fill": "none",
            "halign": "center",
            "valign": "center",
            "padx": 5,
            "pady": 5
          },
          "events": {}
        }
      ]
    }
  ]
}