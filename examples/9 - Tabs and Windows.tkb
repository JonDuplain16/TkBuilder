            "halign": "right",
            "valign": "center",
            "padx": 6,
            "pady": 4
          },
          "events": {
            "command": [
              {
                "type": "check",
                "params": {
                  "target": "name",
                  "condition": "not_empty",
                  "value": "",
                  "message": "Please enter a name on the Profile tab."
                }
              },
              {
                "type": "open_window",
                "params": {
                  "window": "window1",
                  "modal": false
                }
              },
              {
                "type": "set_text",
                "params": {
                  "target": "summary",
                  "text": "{name} is {age} and likes {colour}.\nNewsletter: {newsletter}\nSize: {size_medium}\nVolume: {volume}"
                }
              }
            ]
          },
          "hooks": [
            "command"
          ]
        }
