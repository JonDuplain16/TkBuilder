{
  "version": 2,
  "settings": {
    "app_name": "Tabs and Windows",
    "theme": "rose",
    "font_family": "",
    "font_size": 0,
    "dpi_aware": true,
    "code_style": "split",
    "backend_dir": "",
    "threads": true,
    "description": "Tabs, option groups and a second window filled with {placeholders}."
  },
  "windows": [
    {
      "id": "main_window",
      "type": "Window",
      "props": {
        "title": "Tabs & Windows Demo",
        "icon": "",
        "width": 460,
        "height": 340,
        "min_width": 0,
        "min_height": 0,
        "padding": 12,
        "resizable": true,
        "start": "center",
        "topmost": false,
        "timer_ms": 0,
        "bg": "",
        "menu": []
      },
      "layout": {
        "row": 0,
        "col": 0,
        "rowspan": 1,
        "colspan": 1,
        "fill": "none",
        "halign": "left",
        "valign": "center",
        "padx": 6,
        "pady": 4
      },
      "events": {
        "on_open": [],
        "on_close": [],
        "on_timer": []
      },
      "hooks": [],
