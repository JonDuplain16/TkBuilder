{
  "version": 2,
  "settings": {
    "app_name": "Greeter",
    "theme": "modern_light",
    "font_family": "",
    "font_size": 0,
    "dpi_aware": true,
    "code_style": "split",
    "backend_dir": "",
    "threads": true,
    "description": "Type a name, click: a check and a message with {name_box}."
  },
  "windows": [
    {
      "id": "main_window",
      "type": "Window",
      "props": {
        "title": "Greeter",
        "icon": "",
        "width": 380,
        "height": 200,
        "min_width": 0,
        "min_height": 0,
        "padding": 12,
        "resizable": true,
        "start": "center",
        "topmost": false,
        "timer_ms": 0,
        "bg": "",
        "menu": []
      },
      "layout": {
        "row": 0,
        "col": 0,
        "rowspan": 1,
        "colspan": 1,
        "fill": "none",
        "halign": "left",
        "valign": "center",
        "padx": 6,
        "pady": 4
      },
      "events": {
        "on_open": [],
        "on_close": [],
        "on_timer": []
      },
      "hooks": [],
      "children": [
        {
          "id": "question",
          "type": "Label",
          "props": {
            "text": "What's your name?",
            "variant": "",
            "image": "",
            "compound": "left",
            "anchor": "w",
            "justify": "left",
            "wraplength": 0,
            "width": 0,
            "font": {
              "family": "",
              "size": 0,
              "bold": false,
              "italic": false,
              "underline": false
            },
            "fg": "",
            "bg": "",
            "tooltip": "",
            "cursor": ""
          },
          "layout": {
            "row": 0,
            "col": 0,
            "rowspan": 1,
            "colspan": 1,
            "fill": "none",
            "halign": "left",
            "valign": "center",
            "padx": 6,
            "pady": 4
          },
          "events": {
            "on_click": []
          },
          "hooks": []
        },
        {
          "id": "name_box",
          "type": "Entry",
          "props": {
            "text": "",
            "placeholder": "Type your name",
            "value_type": "text",
            "password": false,
            "justify": "left",
            "state": "normal",
            "width": 20,
            "font": {
              "family": "",
              "size": 0,
              "bold": false,
              "italic": false,
              "underline": false
            },
            "fg": "",
            "bg": "",
            "tooltip": ""
          },
          "layout": {
            "row": 0,
            "col": 1,
            "rowspan": 1,
            "colspan": 1,
            "fill": "x",
            "halign": "left",
            "valign": "center",
            "padx": 6,
            "pady": 4
          },
          "events": {
            "on_enter": [
              {
                "type": "check",
                "params": {
                  "target": "name_box",
                  "condition": "not_empty",
                  "value": "",
                  "message": "Please type your name first."
                }
              },
              {
                "type": "set_text",
                "params": {
                  "target": "greeting",
                  "text": "Hello, {name_box}!"
                }
              }
            ],
            "on_change": []
          },
          "hooks": []
        },
        {
          "id": "hello_button",
          "type": "Button",
          "props": {
            "text": "Say hello",
            "variant": "Accent",
            "image": "",
            "compound": "left",
            "shortcut": "",
            "default": false,
            "width": 0,
            "font": {
              "family": "",
              "size": 0,
              "bold": false,
              "italic": false,
              "underline": false
            },
            "fg": "",
            "bg": "",
            "state": "normal",
            "tooltip": "",
            "cursor": ""
          },
          "layout": {
            "row": 1,
            "col": 1,
            "rowspan": 1,
            "colspan": 1,
            "fill": "none",
            "halign": "right",
            "valign": "center",
            "padx": 6,
            "pady": 4
          },
          "events": {
            "command": [
              {
                "type": "check",
                "params": {
                  "target": "name_box",
                  "condition": "not_empty",
                  "value": "",
                  "message": "Please type your name first."
                }
              },
              {
                "type": "set_text",
                "params": {
                  "target": "greeting",
                  "text": "Hello, {name_box}!"
                }
              }
            ]
          },
          "hooks": [
            "command"
          ]
        },
        {
          "id": "greeting",
          "type": "Label",
          "props": {
            "text": "",
            "variant": "Heading",
            "image": "",
            "compound": "left",
            "anchor": "w",
            "justify": "left",
            "wraplength": 0,
            "width": 0,
            "font": {
              "family": "",
              "size": 0,
              "bold": false,
              "italic": false,
              "underline": false
            },
            "fg": "",
            "bg": "",
            "tooltip": "",
            "cursor": ""
          },
          "layout": {
            "row": 2,
            "col": 0,
            "rowspan": 1,
            "colspan": 2,
            "fill": "none",
            "halign": "left",
            "valign": "center",
            "padx": 6,
            "pady": 4
          },
          "events": {
            "on_click": []
          },
          "hooks": []
        }
      ]
    }
  ]
}