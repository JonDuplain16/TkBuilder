{
  "version": 2,
  "settings": {
    "app_name": "To-Do List",
    "theme": "forest",
    "font_family": "",
    "font_size": 0,
    "dpi_aware": true,
    "code_style": "split",
    "backend_dir": "",
    "threads": true,
    "description": "A list with add/remove and a menu bar."
  },
  "windows": [
    {
      "id": "main_window",
      "type": "Window",
      "props": {
        "title": "To-Do List",
        "icon": "",
        "width": 380,
        "height": 340,
        "min_width": 0,
        "min_height": 0,
        "padding": 12,
        "resizable": true,
        "start": "center",
        "topmost": false,
        "timer_ms": 0,
        "bg": "",
        "menu": [
          {
            "label": "File",
            "items": [
              {
                "label": "Clear all tasks",
                "shortcut": "",
                "hook": false,
                "actions": [
                  {
                    "type": "confirm",
                    "params": {
                      "title": "Please confirm",
                      "message": "Remove every task?"
                    }
                  },
                  {
                    "type": "clear",
                    "params": {
                      "target": "tasks"
                    }
                  }
                ]
              },
              {
                "separator": true
              },
              {
                "label": "Quit",
                "shortcut": "Ctrl+Q",
                "hook": false,
                "actions": [
                  {
                    "type": "quit_app",
                    "params": {}
                  }
                ]
              }
            ]
          },
          {
            "label": "Help",
            "items": [
              {
                "label": "About",
                "shortcut": "",
                "hook": false,
                "actions": [
                  {
                    "type": "show_message",
                    "params": {
                      "title": "About",
                      "message": "A tiny to-do list made with TkBuilder.",
                      "icon": "info"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "layout": {
        "row": 0,
        "col": 0,
        "rowspan": 1,
        "colspan": 1,
        "fill": "none",
        "halign": "left",
        "valign": "center",
        "padx": 6,
        "pady": 4
      },
      "events": {
        "on_open": [],
        "on_close": [],
        "on_timer": []
      },
      "hooks": [],
      "children": [
        {
          "id": "new_task",
          "type": "Entry",
          "props": {
            "text": "",
            "placeholder": "New task",
            "value_type": "text",
            "password": false,
            "justify": "left",
            "state": "normal",
            "width": 20,
            "font": {
              "family": "",
              "size": 0,
              "bold": false,
              "italic": false,
              "underline": false
            },
            "fg": "",
            "bg": "",
            "tooltip": ""
          },
          "layout": {
            "row": 0,
            "col": 0,
            "rowspan": 1,
            "colspan": 1,
            "fill": "x",
            "halign": "left",
            "valign": "center",
            "padx": 6,
            "pady": 4
          },
          "events": {
            "on_enter": [
              {
                "type": "check",
                "params": {
                  "target": "new_task",
                  "condition": "not_empty",
                  "value": "",
                  "message": "Type a task first."
                }
              },
              {
                "type": "add_item",
                "params": {
                  "target": "tasks",
                  "text": "{new_task}"
                }
              },
              {
                "type": "clear",
                "params": {
                  "target": "new_task"
                }
              }
            ],
            "on_change": []
          },
          "hooks": []
        },
        {
          "id": "button1",
          "type": "Button",
          "props": {
            "text": "Add",
            "variant": "Accent",
            "image": "",
            "compound": "left",
            "shortcut": "",
            "default": false,
            "width": 0,
            "font": {
              "family": "",
              "size": 0,
              "bold": false,
              "italic": false,
              "underline": false
            },
            "fg": "",
            "bg": "",
            "state": "normal",
            "tooltip": "",
            "cursor": ""
          },
          "layout": {
            "row": 0,
            "col": 1,
            "rowspan": 1,
            "colspan": 1,
            "fill": "none",
            "halign": "left",
            "valign": "center",
            "padx": 6,
            "pady": 4
          },
          "events": {
            "command": [
              {
                "type": "check",
                "params": {
                  "target": "new_task",
                  "condition": "not_empty",
                  "value": "",
                  "message": "Type a task first."
                }
              },
              {
                "type": "add_item",
                "params": {
                  "target": "tasks",
                  "text": "{new_task}"
                }
              },
              {
                "type": "clear",
                "params": {
                  "target": "new_task"
                }
              }
            ]
          },
          "hooks": [
            "command"
          ]
        },
        {
          "id": "tasks",
          "type": "Listbox",
          "props": {
            "items": [
              "Buy milk",
              "Learn Python"
            ],
            "selectmode": "browse",
            "scrollbar": true,
            "width": 20,
            "height": 6,
            "font": {
              "family": "",
              "size": 0,
              "bold": false,
              "italic": false,
              "underline": false
            },
            "fg": "",
            "bg": "",
            "tooltip": ""
          },
          "layout": {
            "row": 1,
            "col": 0,
            "rowspan": 1,
            "colspan": 2,
            "fill": "both",
            "halign": "left",
            "valign": "center",
            "padx": 6,
            "pady": 4
          },
          "events": {
            "on_select": [],
            "on_double_click": []
          },
          "hooks": []
        },
        {
          "id": "button2",
          "type": "Button",
          "props": {
            "text": "Done \u2714 (remove selected)",
            "variant": "",
            "image": "",
            "compound": "left",
            "shortcut": "",
            "default": false,
            "width": 0,
            "font": {
              "family": "",
              "size": 0,
              "bold": false,
              "italic": false,
              "underline": false
            },
            "fg": "",
            "bg": "",
            "state": "normal",
            "tooltip": "",
            "cursor": ""
          },
          "layout": {
            "row": 2,
            "col": 0,
            "rowspan": 1,
            "colspan": 2,
            "fill": "none",
            "halign": "left",
            "valign": "center",
            "padx": 6,
            "pady": 4
          },
          "events": {
            "command": [
              {
                "type": "remove_selected",
                "params": {
                  "target": "tasks"
                }
              }
            ]
          },
          "hooks": [
            "command"
          ]
        }
      ]
    }
  ]
}